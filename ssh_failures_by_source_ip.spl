index=harsha "Failed password"
| rex field=_raw "(?i)Failed password for (?:invalid user )?(?<username>\S+) from (?<src_ip>\d{1,3}(?:\.\d{1,3}){3})"
| where isnotnull(src_ip)
| stats count AS failed_attempts min(_time) AS first_seen max(_time) AS last_seen values(username) AS usernames by host src_ip
| convert ctime(first_seen) ctime(last_seen)
| sort 0 - failed_attempts
